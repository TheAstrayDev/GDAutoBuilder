# Cocos ABI additions from geode-sdk/geode v6 commit
# 2727299790ef1dfc036c848ff9dbe00c44052087, used with the stable v5 loader.
set(cocos "$ENV{GEODE_SDK}/loader/include/Geode/cocos")
configure_file("${CMAKE_CURRENT_LIST_DIR}/CCTouchClipper.h" "${cocos}/robtop/touch_dispatcher/CCTouchClipper.h" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/CCKeyboardActionManager.h" "${cocos}/robtop/keyboard_dispatcher/CCKeyboardActionManager.h" COPYONLY)
file(READ "${cocos}/base_nodes/CCNode.h" content)
string(REPLACE "bool m_bUnkBool2;" "bool m_bDisableScheduling;" content "${content}")
if(NOT content MATCHES "virtual void offsetPosition")
    string(REPLACE "virtual float getPositionY(void);" "virtual float getPositionY(void);\n    virtual void offsetPosition(float, float);\n    virtual void applyScale(float);" content "${content}")
    file(WRITE "${cocos}/base_nodes/CCNode.h" "${content}")
endif()
file(WRITE "${cocos}/base_nodes/CCNode.h" "${content}")
file(READ "${cocos}/robtop/mouse_dispatcher/CCMouseDelegate.h" content)
string(REPLACE "virtual void scrollWheel(float y, float x) {}" "virtual bool scrollWheel(float y, float x) { return false; }\n    virtual bool rightClick(float, float) { return false; }" content "${content}")
file(WRITE "${cocos}/robtop/mouse_dispatcher/CCMouseDelegate.h" "${content}")
# SDK entry.cpp includes the umbrella UI header, even though this mod uses
# native alerts. Match declarations only; these legacy widgets are never used.
foreach(widget ScrollLayer Scrollbar)
    set(header "$ENV{GEODE_SDK}/loader/include/Geode/ui/${widget}.hpp")
    file(READ "${header}" content)
    string(REPLACE "void scrollWheel(" "bool scrollWheel(" content "${content}")
    file(WRITE "${header}" "${content}")
endforeach()
set(header "${cocos}/robtop/xml/DS_Dictionary.h")
file(READ "${header}" content)
string(REPLACE "loadRootSubDictFromCompressedFile(const char*);" "loadRootSubDictFromCompressedFile(const char*, bool = false);" content "${content}")
string(REPLACE "saveRootSubDictToCompressedFile(const char*);" "saveRootSubDictToCompressedFile(const char*, bool = false);" content "${content}")
file(WRITE "${header}" "${content}")
set(header "${cocos}/touch_dispatcher/CCTouchDispatcher.h")
file(READ "${header}" content)
string(REPLACE "registerForcePrio(cocos2d::CCObject*, int);" "registerForcePrio(cocos2d::CCObject*, int, int = 0);" content "${content}")
file(WRITE "${header}" "${content}")
# Import the added native Cocos exports, absent from the 2.2081 import library.
find_program(RHYTHM_DLLTOOL llvm-dlltool REQUIRED)
set(RHYTHM_COCOS_IMPORT "${CMAKE_CURRENT_BINARY_DIR}/cocos-22091.lib")
execute_process(COMMAND "${RHYTHM_DLLTOOL}" -m i386:x86-64 -d "${CMAKE_CURRENT_LIST_DIR}/cocos-22091.def" -l "${RHYTHM_COCOS_IMPORT}" COMMAND_ERROR_IS_FATAL ANY)
target_link_libraries(${PROJECT_NAME} "${RHYTHM_COCOS_IMPORT}")
file(READ "${cocos}/robtop/keyboard_dispatcher/CCKeyboardDelegate.h" content)
if(NOT content MATCHES "virtual bool handleAction")
    string(REPLACE "virtual void keyUp(enumKeyCodes key, double) {}" "virtual void keyUp(enumKeyCodes key, double) {}\n    virtual bool handleAction(int, bool, double) { return false; }" content "${content}")
    file(WRITE "${cocos}/robtop/keyboard_dispatcher/CCKeyboardDelegate.h" "${content}")
endif()
